# Local host development (Docker Compose PostgreSQL publishes port 55432)
DATABASE_URL=postgresql+psycopg://recallops:recallops@127.0.0.1:55432/recallops
POSTGRES_PASSWORD=recallops
POSTGRES_PORT=55432
ENVIRONMENT=development
# Set a long random token for production and all human hold releases.
OPERATOR_TOKEN=
DEMO_ENABLED=true
PUBLIC_DEMO=false
WORKER_ENABLED=true
SOURCE_REFRESH_SECONDS=3600
SOURCE_MAX_RECORDS=1000
PORT=8080
APP_PORT=8080
# Optional. Leave empty for an honestly labeled deterministic LangGraph fallback.
# OPENAI_API_KEY is also accepted; Compose supports the lowercase openai_api_key alias.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# In containers the Dockerfile supplies FIXTURE_DIR and FRONTEND_DIST.

# Cross-origin mutations are denied unless explicitly listed (comma separated origins).
ALLOWED_ORIGINS=
MUTATION_LIMIT_PER_MINUTE=120
